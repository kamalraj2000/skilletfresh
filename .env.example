# Postgres (docker compose up -d)
DATABASE_URL="postgresql://skillet:skillet@localhost:5432/skilletfresh"

# Auth.js — generate with `npx auth secret` (lands in .env.local)
AUTH_SECRET=

# Planner agent
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-4-8
FDC_API_KEY=DEMO_KEY
# live = agent may fetch recipe sites (several big sites bot-block plain fetches — see scripts/harness-e4-parse.mts)
# corpus = cached recipes only (deterministic, free)
RECIPE_SOURCE=corpus
PLAN_CRON="0 18 * * 0"
TZ=America/Chicago

# Outputs
RESEND_API_KEY=
DIGEST_FROM=
APP_BASE_URL=http://localhost:3000

# Shared secret letting the agent PDF renderer hit /plan/<id>/print without a session
PRINT_TOKEN=
